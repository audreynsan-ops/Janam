# Environment file.
/.env
/.bash_history

# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore "patches" folder as patches are copied by CopyPatches script.
/patches/

# Ignore "services" folder as files are scaffolded. This folder defines the
# settings for building the Docker image.
/services/

# Ignore scaffolded files that are use for local development, so everybody can
# customize them for his local usage specifically.
/docker-compose.override.yml
/local/

# Ignore local configuration files.
/web/sites/*/settings.local.php
/web/sites/development.services.yml
/web/sites/example.settings.local.php

# Ignore configuration files that may contain sensitive information.
#
# It depends on how sensitive data is handled. In the event that the
# configuration files below consistently use environment variables or equivalent
# mechanisms for sensitive data, there is no need to add them here.
# Otherwise, it is essential to ignore them so that such data are never stored
# in the source code, and it is also necessary to adapt the `composer.json` file
# regarding the "scaffold" file mapping: "[web-root]/sites/default/settings.php"
#
#sites/*/settings*.php
#sites/*/services*.yml
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/sites/default/settings.development.php



# Ignore Drupal's file directory
/web/sites/*/files/
# Uncomment if the private folder is not stored as expected, outside the `web`
# folder, as defined in our scaffolded `default.settings.php` file.
#/web/sites/*/private/

# Ignore multi-site test environment.
/web/sites/simpletest

# Ignore configuration htaccess
/config/default/sync/.htaccess
/config/default/sync/README.txt

# Ignore files generated by PhpStorm
/.idea/

# PHPed Files
/web/dbg-wizard.php
/web/dbg-sample.php

# OSX files
.DS_Store

# PHPCS
/.php-cs-fixer.cache

# These files can be ignored because scaffolded.
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/.gitattributes
/.editorconfig

# Ignore some folders used for building assets or playing with local composer
# packages.
/build/
/packages/
